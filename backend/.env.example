NODE_ENV=production
PORT=3000
CORS_ORIGIN=https://lorangerose.be

# PostgreSQL container initialization. Use a long URL-safe password.
POSTGRES_DB=lorangerose
POSTGRES_USER=lorangerose
POSTGRES_PASSWORD=replace-with-a-long-random-value

# The host is "db", matching the Compose service name.
DATABASE_URL=postgresql://lorangerose:replace-with-a-long-random-value@db:5432/lorangerose
DIRECT_URL=postgresql://lorangerose:replace-with-a-long-random-value@db:5432/lorangerose

JWT_SECRET=replace-with-a-different-long-random-value
IP_HASH_SALT=replace-with-another-long-random-value
